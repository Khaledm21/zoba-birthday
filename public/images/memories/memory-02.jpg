<svg xmlns="http://www.w3.org/2000/svg" width="800" height="1000" viewBox="0 0 800 1000">
    <defs>
      <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#2c2240" />
        <stop offset="50%" stop-color="#5c3352" />
        <stop offset="100%" stop-color="#1e172e" />
      </linearGradient>
      <radialGradient id="halo" cx="50%" cy="40%" r="60%">
        <stop offset="0%" stop-color="#F8D98D" stop-opacity="0.25" />
        <stop offset="100%" stop-color="#17172B" stop-opacity="0" />
      </radialGradient>
      <filter id="glow">
        <feGaussianBlur stdDeviation="8" result="coloredBlur"/>
        <feMerge>
          <feMergeNode in="coloredBlur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>
    
    <!-- Background -->
    <rect width="800" height="1000" fill="url(#bg)" />
    <circle cx="400" cy="400" r="350" fill="url(#halo)" />

    <!-- Stars Pattern -->
    <g fill="#FFF5F0" opacity="0.4">
      <circle cx="120" cy="180" r="2" />
      <circle cx="680" cy="150" r="1.5" />
      <circle cx="200" cy="720" r="2.5" />
      <circle cx="710" cy="680" r="1.8" />
      <circle cx="340" cy="110" r="2" />
      <circle cx="580" cy="850" r="2.2" />
      <circle cx="140" cy="500" r="1.5" />
      <circle cx="700" cy="380" r="2" />
    </g>

    <!-- Ornamental Frame -->
    <rect x="50" y="50" width="700" height="900" rx="30" fill="none" stroke="#F8D98D" stroke-width="1.5" stroke-opacity="0.3" />
    <rect x="70" y="70" width="660" height="860" rx="20" fill="none" stroke="#F8D98D" stroke-width="1" stroke-dasharray="8 8" stroke-opacity="0.2" />

    <!-- Center Icon Circle -->
    <circle cx="400" cy="400" r="90" fill="#17172B" fill-opacity="0.6" stroke="#F8D98D" stroke-width="2" filter="url(#glow)" />
    <text x="400" y="425" font-size="64" text-anchor="middle">💫</text>

    <!-- Typography -->
    <text x="400" y="580" font-family="'Cairo', sans-serif" font-size="34" font-weight="700" fill="#FFF5F0" text-anchor="middle" letter-spacing="1">
      ضحك من القلب
    </text>
    <text x="400" y="630" font-family="'DM Sans', sans-serif" font-size="22" font-weight="500" fill="#F8D98D" text-anchor="middle" letter-spacing="2">
      Unfiltered Laughter
    </text>
    <text x="400" y="720" font-family="'DM Sans', sans-serif" font-size="14" fill="#C5BFD8" text-anchor="middle" opacity="0.7" letter-spacing="1">
      FOR ZOBA • A CHERISHED MEMORY
    </text>

    <!-- Bottom Tag -->
    <rect x="300" y="800" width="200" height="36" rx="18" fill="#17172B" fill-opacity="0.7" stroke="#F8D98D" stroke-width="1" stroke-opacity="0.4" />
    <text x="400" y="823" font-family="'DM Sans', sans-serif" font-size="12" font-weight="600" fill="#F8D98D" text-anchor="middle" letter-spacing="1.5">
      ZOBA ✨ 2026
    </text>
  </svg>